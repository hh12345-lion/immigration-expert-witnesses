# Google Sheets (contact form submissions) — do not commit real credentials
# Share the spreadsheet with the service account email as Editor.
# Private key: paste from the JSON file with literal \n sequences, wrapped in double quotes.
GOOGLE_SERVICE_ACCOUNT_EMAIL=sheets-writer@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your_spreadsheet_id_here
GOOGLE_SHEET_TAB_NAME=Sheet1
