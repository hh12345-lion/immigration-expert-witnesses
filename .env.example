NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_HOTJAR_ID=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Lead webhook (n8n) — set in Netlify → Environment variables and locally for netlify dev
# Fallback name also accepted: LEAD_NOTIFICATION_URL
# Do not commit real URLs
Lead_notification_url=

# Google Sheets (contact form submissions) — do not commit real credentials
# Share the spreadsheet with GOOGLE_SERVICE_ACCOUNT_EMAIL as Editor.
# Private key: paste from the JSON file with literal \n sequences (no wrapping quotes),
# OR set GOOGLE_PRIVATE_KEY_B64 to base64 of the full PEM (recommended on Netlify).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_PRIVATE_KEY_B64=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB_NAME=Sheet1
